{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "MassTransit": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog" } }
    ],
    "Properties": { "Service": "Licensing.Worker" }
  },
  "ConnectionStrings": {
    "licensing-db": "Host=localhost;Port=5432;Database=licensing;Username=postgres;Password=postgres",
    "messaging": "amqp://guest:guest@localhost:5672"
  },
  "PhotoCheck": { "MinSizeBytes": 10240, "MinQualityScore": 0.3 },
  "Risk": {
    "MinAgeForAutoApproval": 21,
    "AutoApprovalCategories": [ "B" ],
    "Watchlist": [ "XY999999" ],
    "MinPhotoQualityForAutoApproval": 0.6
  }
}